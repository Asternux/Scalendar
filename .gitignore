output/*
!output/.gitkeep
*.png
*.jpg
*.jpeg
*.webp
*.heic
*.pdf
*.xlsx
*.xls
*.ics

# Temporary and build artifacts
temp/*
!temp/.gitkeep
build/
dist/
*.spec
*.exe
*.log
*.tmp
*.temp
*.bak
*.swp

# IDE and operating-system files
.idea/
.vscode/
.vs/
.fleet/
